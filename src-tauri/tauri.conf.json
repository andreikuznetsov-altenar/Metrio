{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Metrio",
  "version": "0.1.4",
  "identifier": "com.altenar.metrio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 1180,
        "height": 760,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "hardenedRuntime": true,
      "signingIdentity": "Developer ID Application: Andrei Kuznetsov (V36L7T43H8)"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
